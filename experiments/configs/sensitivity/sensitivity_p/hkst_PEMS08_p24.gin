build.module = 'experiments.forecast'
build.repeat = 3
build.data_dir = 'PEMS08/data.dat'
build.model_type = 'hkst'
build.subdir = 'sensitivity_p'

# Largest valid patch configuration for input_len=48; the third patch
# already equals the full input window.
build.variables_dict = {
    'seed': [42, 123, 456],
    'instance.output_len': [24, 48, 72, 96],
    'hkst.patch_sizes': [(24, 36, 48)],
    'hkst.strides': [(12, 18, 24)]
}

instance.input_len = 48
hkst.num_feat = 3
hkst.hidden_dim = 128
hkst.spat_layers = 3
hkst.temp_layers = 2
hkst.spat_rank = 64
hkst.temp_rank = 128
hkst.spat_decomp = True
hkst.use_node_modem = True
hkst.use_graph = True
hkst.te_ortho_loss = True
hkst.sp_ortho_loss = True
hkst.recon_mask_ratio = 0.5

train.loss_name = 'mse'
train.epochs = 50
get_scheduler.warmup_epochs = 5
get_data.batch_size = 32
Checkpoint.patience = 7

ForecastDataset.scale = True
ForecastDataset.train_size = 0.6
ForecastDataset.val_size = 0.2
ForecastDataset.test_size = 0.2

instance.save_vals = False
instance.save_pth = False
instance.gso_path = 'PEMS08/adj_mx.pkl'
instance.gso_type = 'sym_renorm_adj'
