build.module = 'experiments.forecast'
build.repeat = 3
build.data_dir = 'PEMS03/data.dat'
build.model_type = 'pdformer'
build.subdir = 'reviewer_baselines'
build.variables_dict = {'seed': [42, 123, 456], 'instance.output_len': [24, 48, 72, 96]}
instance.input_len = 48
pdformer.asset_path = 'PEMS03/pdformer_assets.npz'
pdformer.time_feature_style = 'pems'
train.loss_name = 'mse'
train.epochs = 50
train.gradient_accumulation_steps = 16
get_scheduler.warmup_epochs = 5
get_data.batch_size = 2
Checkpoint.patience = 7
ForecastDataset.scale = True
ForecastDataset.train_size = 0.6
ForecastDataset.val_size = 0.2
ForecastDataset.test_size = 0.2
instance.save_vals = False
instance.save_pth = False
instance.gso_path = 'PEMS03/adj_mx.pkl'
