build.module = 'experiments.forecast'
build.repeat = 3
build.data_dir = 'PEMS04/data.dat'
build.model_type = 'hkst'
build.subdir = 'ablation_wokoopman'

build.variables_dict = {
    'seed': [42, 123, 456],
    'instance.output_len': [24, 48, 72, 96],
    'hkst.evolution_mode': ['none']
}

instance.input_len = 48
hkst.num_feat = 3
hkst.hidden_dim = 128
hkst.spat_layers = 3
hkst.temp_layers = 2
hkst.spat_rank = 128
hkst.temp_rank = 128
hkst.spat_decomp = True
hkst.use_node_modem = True
hkst.use_graph = True
hkst.patch_sizes = [16, 24, 32]
hkst.strides = [8, 12, 16]
hkst.te_ortho_loss = True
hkst.sp_ortho_loss = True
hkst.recon_mask_ratio = 0.5
# w/o Koopman ablation (Plan B): identity evolution; the matrix K is removed.
# All other modules (lift U / unlift V, temporal forcing, node modulation,
# orthogonality on U·V) are preserved to isolate the contribution of K.
# evolution_mode is enumerated through build.variables_dict above so that the
# experiment_storage path includes it, separating these runs from any
# previous IJCAI-era HiDe-KST runs that share the same dataset/output_len.

train.loss_name = 'mse'
train.epochs = 50
get_scheduler.warmup_epochs = 5
get_data.batch_size = 32
Checkpoint.patience = 5

ForecastDataset.scale = True
ForecastDataset.train_size = 0.6
ForecastDataset.val_size = 0.2
ForecastDataset.test_size = 0.2

# wokoopman 的 model.pth 不被任何分析脚本使用（freq/eigen 自动跳过 none 模式），
# 因此关闭 save_pth 节省约一半中间文件空间。仅保留 preds/trues 给长程稳定性分析。
instance.save_vals = True
instance.save_pth = False
instance.gso_path = 'PEMS04/adj_mx.pkl'
instance.gso_type = 'sym_renorm_adj'
