build.module = 'experiments.forecast'
build.repeat = 3
build.data_dir = 'water_mn/data.csv'
build.model_type = 'hkst'
build.subdir = 'ablation_wokoopman'

build.variables_dict = {
    'seed': [42, 123, 456],
    'instance.output_len': [24, 48, 72, 96],
    'hkst.evolution_mode': ['none'],
    'Checkpoint.patience': [7]
}

instance.input_len = 48
hkst.num_feat = 5
hkst.hidden_dim = 128
hkst.spat_layers = 3
hkst.temp_layers = 2
hkst.spat_rank = 8
hkst.temp_rank = 128
hkst.use_timestamp = False
hkst.spat_decomp = True
hkst.use_node_modem = True
hkst.use_graph = True
hkst.patch_sizes = [16, 24, 32]
hkst.strides = [8, 12, 16]
hkst.te_ortho_loss = True
hkst.sp_ortho_loss = True
hkst.recon_mask_ratio = 0.5

train.loss_name = 'mse'
train.epochs = 50
get_scheduler.warmup_epochs = 5
get_data.batch_size = 32
Checkpoint.patience = 7

ForecastDataset.scale = True
ForecastDataset.train_size = 0.7
ForecastDataset.val_size = 0.1
ForecastDataset.test_size = 0.2

# wokoopman 的 model.pth 不被任何分析脚本使用（freq/eigen 自动跳过 none 模式），
# 因此关闭 save_pth 节省约一半中间文件空间。仅保留 preds/trues 给长程稳定性分析。
instance.save_vals = True
instance.save_pth = False
instance.gso_path = 'water_mn/adj_mx.pkl'
instance.gso_type = 'sym_renorm_adj'
