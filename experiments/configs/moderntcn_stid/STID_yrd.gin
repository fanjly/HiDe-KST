build.module = 'experiments.forecast'
build.repeat = 3
build.data_dir = 'air_yrd/data.nc'
build.model_type = 'stid'
build.subdir = 'moderntcn_stid'
build.variables_dict = {'seed': [42, 123, 456], 'instance.output_len': [24, 48, 72, 96], 'ForecastDataset.variable_name': ['PM2.5', 'O3']}
instance.input_len = 48
stid.num_time_features = 4
stid.embed_dim = 32
stid.node_dim = 32
stid.temp_dim_tid = 32
stid.temp_dim_diw = 32
stid.num_layers = 3
stid.dropout = 0.15
stid.time_of_day_size = 24
stid.calendar_features = True
train.loss_name = 'mse'
train.epochs = 50
get_optimizer.lr = 0.002
get_scheduler.warmup_epochs = 5
get_data.batch_size = 32
Checkpoint.patience = 7
ForecastDataset.scale = True
ForecastDataset.train_size = 0.5
ForecastDataset.val_size = 0.25
ForecastDataset.test_size = 0.25
instance.save_vals = False
instance.save_pth = False
