build.module = 'experiments.forecast'
build.repeat = 3
build.data_dir = 'PEMS08/data.dat'
build.model_type = 'moderntcn'
build.subdir = 'moderntcn_stid'
build.variables_dict = {'seed': [42, 123, 456], 'instance.output_len': [24, 48, 72, 96]}
instance.input_len = 48
moderntcn.patch_size = 8
moderntcn.patch_stride = 4
moderntcn.num_blocks = (1,)
moderntcn.large_kernels = (31,)
moderntcn.small_kernels = (5,)
moderntcn.dims = (64,)
moderntcn.ffn_ratio = 1
moderntcn.downsample_ratio = 2
moderntcn.dropout = 0.1
moderntcn.use_multi_scale = False
moderntcn.revin = True
moderntcn.affine = False
train.loss_name = 'mse'
train.epochs = 50
get_optimizer.lr = 0.001
get_scheduler.warmup_epochs = 5
get_data.batch_size = 32
Checkpoint.patience = 7
ForecastDataset.scale = True
ForecastDataset.train_size = 0.6
ForecastDataset.val_size = 0.2
ForecastDataset.test_size = 0.2
instance.save_vals = False
instance.save_pth = False
