build.module = 'experiments.forecast'
build.repeat = 3
build.data_dir = 'PEMS04/data.dat'
build.model_type = 'skolr'
build.subdir = 'modern_baselines'
build.variables_dict = {'seed': [42, 123, 456], 'instance.output_len': [24, 48, 72, 96]}
instance.input_len = 48
skolr.num_branches = 2
skolr.dynamic_dim = 256
skolr.hidden_dim = 512
skolr.hidden_layers = 2
skolr.patch_len = 8
skolr.dropout = 0.05
train.loss_name = 'mse'
train.epochs = 50
get_optimizer.lr = 0.0001
get_optimizer.weight_decay = 0.0005
get_optimizer.optimizer_name = 'adamw'
get_scheduler.warmup_epochs = 5
get_data.batch_size = 32
Checkpoint.patience = 7
ForecastDataset.scale = True
ForecastDataset.train_size = 0.6
ForecastDataset.val_size = 0.2
ForecastDataset.test_size = 0.2
instance.save_vals = False
instance.save_pth = False
