build.module = 'experiments.forecast'
build.repeat = 3
build.data_dir = 'water_o2/data.csv'
build.model_type = 'dlinear'

build.variables_dict = {
    'seed': [42, 123, 456],
    'instance.output_len': [24, 48, 72, 96]
}

instance.input_len = 48
dlinear.individual = False

train.loss_name = 'mse'
train.epochs = 50
get_scheduler.warmup_epochs = 5
get_data.batch_size = 32
Checkpoint.patience = 7

ForecastDataset.scale = True
ForecastDataset.train_size = 0.7
ForecastDataset.val_size = 0.1
ForecastDataset.test_size = 0.2

instance.save_vals = False
